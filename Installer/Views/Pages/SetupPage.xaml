<UserControl x:Class="Installer.Views.Pages.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Installer.Views.Pages"
             mc:Ignorable="d" 
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel HorizontalAlignment="Stretch"
            Margin="0 0 0 30">
                <Path Style="{DynamicResource dataLoggerLogo}"
                      Margin="0 0 0 6"
                      HorizontalAlignment="Center" />

                <TextBlock Text="DATA LOGGER" Style="{DynamicResource text_logoTEXT02}"
                           Margin="0 0 0 30"
                           Foreground="{DynamicResource PrimaryColour}"
                           HorizontalAlignment="Center"/>

                <TextBlock Style="{DynamicResource HEADING5}"
                           Text="Setup"
                           Margin="0 0 0 24"/>

                <TextBlock Style="{DynamicResource text_LABEL02}"
                           Text="Click install below to begin the installation process. On completion of the installation you may choose to launch the application."
                           TextWrapping="WrapWithOverflow"
                           TextAlignment="Left"
                           FontSize="16"
                           FontWeight="Regular"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Stretch">

                <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                    <TextBlock Style="{DynamicResource text_LABEL02}"
                           Text="Install Location:"
                           Foreground="{DynamicResource iconCOLOURAccent02}"
                           TextAlignment="Left"
                           FontSize="16"
                           FontWeight="Regular"
                           Margin="0 0 6 0"/>

                    <TextBlock x:Name="textBlock_INSTALL_LOCATION"  Style="{DynamicResource text_button01}"
                               Foreground="{DynamicResource iconCOLOURAccent01}"
                               TextAlignment="Left"
                               FontSize="16"
                               FontWeight="Regular" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 0 0 24">
                    <TextBlock Style="{DynamicResource text_LABEL02}"
                               Text="Size:"
                               Foreground="{DynamicResource iconCOLOURAccent02}"
                               TextAlignment="Left"
                               FontSize="16"
                               FontWeight="Regular"
                               Margin="0 0 6 0"/>

                    <TextBlock x:Name="textBlock_APP_SIZE"  Style="{DynamicResource text_button01}"
                               Foreground="{DynamicResource iconCOLOURAccent01}"
                               TextAlignment="Left"
                               FontSize="16"
                               FontWeight="Regular" />
                </StackPanel>

                <StackPanel>
                    <Grid x:Name="grid_SETUP_SHORTCUT" Grid.Column="1"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="0 0 0 6" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <CheckBox x:Name="checkBox_CREATE_SHORTCUT" Style="{DynamicResource check_SIGNUP}"
                                  IsChecked="False" 
                                  Checked="on_CREATE_SHORTCUT_Checked"
                                  Unchecked="on_CREATE_SHORTCUT_Unchecked" />

                        <TextBlock Grid.Column="2" Style="{DynamicResource text_LABEL02}"
                                   Text="Create Desktop Shortcut" />

                    </Grid>

                    <Grid x:Name="grid_SETUP_TASKBAR_PIN" Grid.Column="1"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"
                          Margin="0 0 0 6" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <CheckBox x:Name="checkBox_PIN_TASKBAR" Style="{DynamicResource check_SIGNUP}"
                                  IsChecked="False" />

                        <TextBlock Grid.Column="2" Style="{DynamicResource text_LABEL02}"
                                   Text="Pin to Taskbar" />

                    </Grid>

                    <Grid x:Name="grid_SETUP_DLS_EXTENSION" Grid.Column="1"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="0 0 0 6" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <CheckBox x:Name="checkBox_ASSOCIATE_DLS" Style="{DynamicResource check_SIGNUP}"
                                  IsChecked="True" />

                        <TextBlock Grid.Column="2" Style="{DynamicResource text_LABEL02}"
                                   Text="Associate .dls files with Data Logger" />

                    </Grid>
                </StackPanel>



            </StackPanel>
        </StackPanel>

        <Button Grid.Row="2" Style="{DynamicResource PRIMARY}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Click="on_INSTALL_ClickedAsync">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{DynamicResource text_button01}"
                           Text="Install" />

            </StackPanel>
        </Button>
    </Grid>
</UserControl>
