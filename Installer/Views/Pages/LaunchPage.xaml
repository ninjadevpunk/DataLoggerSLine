<UserControl x:Class="Installer.Views.Pages.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Installer.Views.Pages"
             mc:Ignorable="d"
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Stretch">
            <Path Style="{DynamicResource dataLoggerLogo}"
          Margin="0 0 0 6"
          HorizontalAlignment="Center" />

            <TextBlock Text="DATA LOGGER" Style="{DynamicResource text_logoTEXT02}"
               Margin="0 0 0 30"
               Foreground="{DynamicResource PrimaryColour}"
               HorizontalAlignment="Center"/>

            <TextBlock Style="{DynamicResource HEADING5}"
               Text="Installation Complete"
               Margin="0 0 0 24"/>

            <Grid x:Name="grid_SETUP_LAUNCH"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <CheckBox x:Name="checkBox_LAUNCH" Style="{DynamicResource check_SIGNUP}"
                          IsChecked="False" />

                <TextBlock Grid.Column="2" Style="{DynamicResource text_LABEL02}"
               Text="Launch Data Logger" />

            </Grid>
        </StackPanel>

        <Button Grid.Row="2" Style="{DynamicResource ACTION}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom" 
                Click="on_FINISH_Clicked" >
            <TextBlock Style="{DynamicResource text_button01}"
               Text="Finish" />
        </Button>
    </Grid>
</UserControl>
