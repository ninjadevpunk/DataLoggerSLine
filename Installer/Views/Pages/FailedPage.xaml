<UserControl x:Class="Installer.Views.Pages.FailedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Installer.Views.Pages"
             mc:Ignorable="d"
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Stretch">
            <Path Style="{DynamicResource dataLoggerLogo}"
                  Margin="0 0 0 6"
                  HorizontalAlignment="Center" />

            <TextBlock Text="DATA LOGGER" Style="{DynamicResource text_logoTEXT02}"
                       Margin="0 0 0 30"
                       Foreground="{DynamicResource PrimaryColour}"
                       HorizontalAlignment="Center"/>

            <TextBlock Style="{DynamicResource HEADING5}"
                       Text="Installation Failed"
                       Margin="0 0 0 24"/>

            <TextBlock x:Name="textBlock_ERROR_MESSAGE" Style="{DynamicResource text_LABEL02}"
                       TextWrapping="WrapWithOverflow"
                       TextAlignment="Left"
                       FontSize="16"
                       FontWeight="Regular"/>
        </StackPanel>

        <Button x:Name="button_RETRY" Grid.Row="2" Style="{DynamicResource ACTION}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Click="on_RETRY_Clicked">
            <TextBlock x:Name="textBlock_RETRY" Style="{DynamicResource text_button01}"
                       Text="Retry" />
        </Button>
    </Grid>
</UserControl>
