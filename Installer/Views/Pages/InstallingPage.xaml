<UserControl x:Class="Installer.Views.Pages.InstallingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Installer.Views.Pages"
             mc:Ignorable="d" 
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Stretch">
            <Path Style="{DynamicResource dataLoggerLogo}"
          Margin="0 0 0 6"
          HorizontalAlignment="Center" />

            <TextBlock Text="DATA LOGGER" Style="{DynamicResource text_logoTEXT02}"
               Margin="0 0 0 30"
               Foreground="{DynamicResource PrimaryColour}"
               HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel x:Name="stackPanel_PROGRESSBAR" Grid.RowSpan="2"
                    Height="auto"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            
            <TextBlock Text="Installing..." Style="{DynamicResource HEADING5}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top" />


            <ProgressBar Grid.ColumnSpan="3" x:Name="progressBar_UPDATE"
                         Height="12"
                         Width="auto"
                         FlowDirection="LeftToRight"
                         Foreground="{DynamicResource PrimaryColour}"
                         Background="{DynamicResource PANELWHITE}"
                         BorderThickness="0"
                         Orientation="Horizontal"
                         Margin="0 24 0 0"
                         IsIndeterminate="True"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />



        </StackPanel>
    </Grid>
</UserControl>
