<UserControl x:Class="Installer.Views.Pages.IntroPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Installer.Views.Pages"
             mc:Ignorable="d"
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Stretch">
            <Path Style="{DynamicResource dataLoggerLogo}"
              Margin="0 0 0 6"
              HorizontalAlignment="Center" />

            <TextBlock Text="DATA LOGGER" Style="{DynamicResource text_logoTEXT02}"
                   Margin="0 0 0 30"
                   Foreground="{DynamicResource PrimaryColour}"
                   HorizontalAlignment="Center"/>

            <TextBlock Style="{DynamicResource HEADING5}"
                   Text="Installation Wizard"
                   Margin="0 0 0 24"/>

            <TextBlock Style="{DynamicResource text_LABEL02}"
                   Text="Welcome to the Data Logger Installation Wizard. This wizard will guide you through the installation of the application on your computer. You’ll be able to configure additional options before the installation begins. Please proceed when you’re ready."
                   TextWrapping="WrapWithOverflow"
                   TextAlignment="Left"
                   FontSize="16"
                   FontWeight="Regular"/>
        </StackPanel>

        <Button Grid.Row="2" Style="{DynamicResource ACTION}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom" Click="on_NEXT_Clicked">
            <TextBlock Style="{DynamicResource text_button01}"
                   Text="Next" />
        </Button>
    </Grid>
</UserControl>
