<Page x:Class="Data_Logger_1._3.Views.Account.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Data_Logger_1._3.Views.Account" xmlns:components="clr-namespace:Data_Logger_1._3.Components"
      mc:Ignorable="d"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      d:Background="White"
      Title="Settings">

    <Border Padding="40 60">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="650"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="45" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <!-- #region SETTINGS FIELDS SIDE -->


            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="20 10 20 10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="45" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <!-- HEADING -->
                    <TextBlock Grid.Column="0" Grid.Row="0" Style="{DynamicResource HEADING5}"
       Text="SETTINGS"/>






                    <!--#region ACCOUNT FIELDS -->





                    <StackPanel Grid.Row="3" VerticalAlignment="Stretch">

                        <!-- ACCOUNT -->
                        <Border Padding="10 30">
                            <TextBlock Text="Account" Style="{DynamicResource text_minorHEADING1}" />
                        </Border>

                        <!-- Profile Picture -->
                        <Border Padding="30 10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>


                                <Border x:Name="image_PROFILE_PIC" Style="{DynamicResource image_displayPic}"
                        >
                                    <Path Style="{DynamicResource path_USER}"
                          Visibility="{Binding DefaultPicVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>

                                <!-- Browse Button -->
                                <Button Grid.Column="2"  x:Name="button_BROWSE_PICTURE" Style="{DynamicResource ACTIONBrowse}"
                        Command="{Binding OpenImageCommand}">
                                    <TextBlock Style="{DynamicResource text_button01}"
                               Text="Browse"/>
                                </Button>


                                <TextBlock Grid.Column="4" Style="{DynamicResource text_LABEL02}"
                           Text="{Binding DisplayPicPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           TextAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Stretch"/>

                                <!-- Reset Button -->
                                <Button Grid.Column="6"  x:Name="button_RESET_PICTURE" Style="{DynamicResource ACTION}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Width="auto"
                        Command="{Binding ResetImageCommand}">
                                    <TextBlock Style="{DynamicResource text_button01}"
                               TextDecorations="Underline"
                               Text="Reset"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- FIRST AND LAST NAME -->
                        <Grid Margin="0 2.5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- FIRST NAME -->
                            <components:PlainInputField x:Name="inputText_FIRSTNAME" Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    PlaceholderText="Name"
                    DynamicPlaceholderText="Name"
                    UserTextBoxStyle="{DynamicResource inputText_LOGIN}"
                    UserTextBlockStyle="{DynamicResource text_login_PLACEHOLDER}"
                    UserInput="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />

                            <!-- LAST NAME -->
                            <components:PlainInputField x:Name="inputText_SURNAME" Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    PlaceholderText="Surname"
                    DynamicPlaceholderText="Surname"
                    UserTextBoxStyle="{DynamicResource inputText_LOGIN}"
                    UserTextBlockStyle="{DynamicResource text_login_PLACEHOLDER}"
                    UserInput="{Binding Surname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />


                        </Grid>

                        <!-- EMAIL -->
                        <Grid Margin="0 2.5">
                            <components:PlainInputField x:Name="inputText_EMAIL"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        PlaceholderText="Email*"
                                        DynamicPlaceholderText="Email*"
                                        UserTextBoxStyle="{DynamicResource inputText_LOGIN}"
                                        UserTextBlockStyle="{DynamicResource text_login_PLACEHOLDER}"
                                        UserInput="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>


                        <!-- EMPLOYEE? -->
                        <Grid Margin="0 2.5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{DynamicResource text_LABEL01}"
                       Text="Company Employee"
                       TextAlignment="Left"
                       Padding="10 0"/>

                            <Grid Grid.Column="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="10">


                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>


                                <!-- YES -->
                                <TextBlock Grid.Column="0" Style="{DynamicResource text_LABEL02}"
                           Text="Yes"
                           Margin="5 0"/>

                                <CheckBox Grid.Column="1" Style="{DynamicResource check_SIGNUP}" x:Name="checkBox_YES"
                          IsChecked="{Binding YesBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0 0 10 0"/>


                                <!-- NO -->
                                <TextBlock Grid.Column="2" Style="{DynamicResource text_LABEL02}"
                           Text="No"
                           Margin="5 0"/>

                                <CheckBox Grid.Column="3" Style="{DynamicResource check_SIGNUP}" x:Name="checkBox_NO"
                          Background="{DynamicResource iconCOLOURAccent01}"
                          Foreground="{DynamicResource WHITE}"
                          IsChecked="{Binding NoBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            </Grid>
                        </Grid>

                        <!-- NAME OF COMPANY -->
                        <Grid Margin="0 2.5">
                            <components:PlainInputField x:Name="inputText_COMPANY"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        PlaceholderText="Company Name*"
                                        DynamicPlaceholderText="Company Name*"
                                        IsEnabled="{Binding YesBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        UserTextBoxStyle="{DynamicResource inputText_LOGIN}"
                                        UserTextBlockStyle="{DynamicResource text_login_PLACEHOLDER}"
                                        UserInput="{Binding CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- COMPANY ADDRESS -->
                        <Grid Margin="0 2.5">
                            <components:PlainInputField x:Name="inputText_COMPANY_ADDRESS"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        PlaceholderText="Company Address"
                                        DynamicPlaceholderText="Company Address"
                                        IsEnabled="{Binding YesBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        UserTextBoxStyle="{DynamicResource inputText_LOGIN}"
                                        UserTextBlockStyle="{DynamicResource text_login_PLACEHOLDER}"
                                        UserInput="{Binding CompanyAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                    </StackPanel>









                    <StackPanel Grid.Row="4">
                        <Border Padding="10" HorizontalAlignment="Stretch">
                            <Button x:Name="button_PASSWORD_RESET_LINK" Style="{DynamicResource ACTION}"
                HorizontalAlignment="Right"
                Width="auto"
                Command="{Binding PasswordResetCommand}">

                                <TextBlock Style="{DynamicResource text_button01}"
                    Text="Request Password Reset"/>
                            </Button>
                        </Border>

                        <StackPanel x:Name="stackPanel_PASSWORD_RESET_SECTION" Height="0">

                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <!-- VERIFICATION CODE -->
                                <components:PlainInputField x:Name="inputText_VERIFICATION_CODE" Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            PlaceholderText="Enter Verification Code"
                                            DynamicPlaceholderText="Enter Verification Code"
                                            UserTextBoxStyle="{DynamicResource inputText_LOGIN}"
                                            UserTextBlockStyle="{DynamicResource text_login_PLACEHOLDER}"
                                            UserInput="{Binding VerificationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            />

                                <Button Grid.Column="2" x:Name="button_VERIFICATION_CODE" Style="{DynamicResource ACTION}"
                            HorizontalAlignment="Right"
                            Width="auto"
                            Command="{Binding SubmitVerificationCodeCommand}">

                                    <TextBlock Style="{DynamicResource text_button01}"
                                   Text="Submit"/>
                                </Button>

                            </Grid>

                            
                        </StackPanel>

                        <StackPanel x:Name="stackPanel_NEW_PASSWORD_SECTION" Height="0">
                            <Border Padding="10" HorizontalAlignment="Stretch">
                                <!-- NEW PASSWORD -->
                                <components:PasswordInputField x:Name="inputText_NEW_PASSWORD" Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Placeholder="New Password"
                    UserInput="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                            </Border>

                            <!-- CONFIRM PASSWORD -->
                            <Border Padding="10" HorizontalAlignment="Stretch">
                                <components:PasswordInputField x:Name="inputText_CONFIRM_PASSWORD" Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Placeholder="Confirm Password"
                    UserInput="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                            </Border>

                            <Border Padding="10" HorizontalAlignment="Stretch">
                                <Button Grid.Column="2" x:Name="button_CHANGE_PASSWORD" Style="{DynamicResource ACTION}"
HorizontalAlignment="Right"
Width="auto"
Command="{Binding ChangePasswordCommand}">

                                    <TextBlock Style="{DynamicResource text_button01}"
       Text="Change Password"/>
                                </Button>
                            </Border>

                        </StackPanel>

                    </StackPanel>


                    <Border Grid.Row="5"
            Padding="10"
            HorizontalAlignment="Stretch">


                        <Button x:Name="button_DELETE_ACCOUNT" Style="{DynamicResource ACTION}"
                HorizontalAlignment="Right"
                Command="{Binding DeleteAccountCommand}">

                            <TextBlock Style="{DynamicResource text_button01}"
                       Text="Delete Account"/>
                        </Button>
                    </Border>
                    <!--#endregion-->







                    <!-- #region THEME FIELDS -->
                    <StackPanel Grid.Row="6" VerticalAlignment="Stretch" Visibility="Collapsed" >

                        <!-- THEME -->
                        <Border Padding="10 30">
                            <TextBlock Text="Theme" Style="{DynamicResource text_minorHEADING1}" />
                        </Border>


                        <!-- Theme Options -->
                        <components:ComboBoxInputField x:Name="theme_CHOICE"
                                       UserTextBoxStyle="{DynamicResource inputText}"
                                       Enabled="False"
                                       UserComboInput="Grey"
                                       IsEnabled="False"
                                       />


                    </StackPanel>

                </Grid>
            </ScrollViewer>




            <!--#endregion-->



            <!-- #region SUBMIT -->


            <!-- SAVE BUTTON -->
            <Button x:Name="button_SAVE" Grid.Row="2" Style="{DynamicResource PRIMARY}"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                IsEnabled="{Binding SaveIsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Command="{Binding SaveSettingsCommand}">


                <TextBlock Style="{DynamicResource text_button01}"
                       Text="SAVE"
                       />
            </Button>



            <!--#endregion-->
            
            
            
            
            
            
            
            
            
            
            
            
            <!--#endregion-->



            <!-- #region Return to Dashboard -->

            <!-- RETURN TO DASHBOARD BUTTON -->
            <Button x:Name="button_RETURN" Grid.Row="2" Grid.Column="2" Style="{DynamicResource ACTIONReturnToDashboard}"
                    Margin="30 0 0 0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Command="{Binding ReturnToDashboardCommand}" />

            <!--#endregion-->

        </Grid>
    </Border>
</Page>
